# Copperline mirror (Morrow v2). Set these per act in the Vercel project environment.

# Current act, 1-10.
MORROW_ACT=1
# When the act began, ISO 8601 WITH a UTC offset (a value without one is read as UTC on Vercel).
# Drives Theo's timed drops and the 24/72/120 h hints; if unset, those never fire.
MORROW_ACT_STARTED=2026-10-17T19:00:00-05:00
# Comma-separated Minecraft names of the players (Act 9 backdated forum profiles).
MORROW_PLAYERS=
# host:port of the Mossfield server (Act 10 console readiness check and the heartbeat).
MORROW_MC_HOST=

# The mrrw plugin's bridge (plugins/mrrw/config.yml bridge port), e.g. http://mc.example.net:25588.
# When it answers, the site serves the later of MORROW_ACT and the plugin's act (acts advance by
# themselves from desk filings), takes act_started and the resident count from the plugin (hint timers
# scale with group size), and the Act 10 console only accepts the #general vote's USB winner.
# Requests are signed with MORROW_STOP_SECRET. Unset or unreachable: the env values above, as before.
MORROW_BRIDGE_URL=
# Optional: how long the site caches the plugin's state, in ms (default 25000).
# MORROW_BRIDGE_TTL_MS=25000

# Secrets: long random values, e.g. `openssl rand -hex 32`. Production refuses to start signing without them.
# Signs WHMCS sessions, desk tickets, file and voice links.
MORROW_SESSION_SECRET=
# Shared with the mrrw plugin; signs the Act 10 stop code. Compare the fingerprint the server logs
# at start with `/mrrw status` in game before the finale.
MORROW_STOP_SECRET=

# Local testing only (dashboard/scripts/dev-v2.mjs sets them). NEVER set these in production:
# MORROW_DEV=1         act-switcher cookie overrides MORROW_ACT; /dev-act works
# MORROW_DESK_FAST=1   Theo answers immediately and every timed drop/hint is released
