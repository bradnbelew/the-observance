NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Exact allow-list checked after Supabase login in the author console.
ADMIN_EMAILS=

# Required HTTP Basic credentials for every /author request and server action.
# Use a unique, high-entropy password, configure the same values in hosting,
# and serve the dashboard only over HTTPS so credentials are encrypted in transit.
AUTHOR_USERNAME=director
AUTHOR_PASSWORD=
