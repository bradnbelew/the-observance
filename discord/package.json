{
  "name": "the-observance-discord",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Observance — Discord service: slash commands, whisper hints, and satori-rendered clue cards.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "register": "tsx src/bot/register.ts",
    "dev": "tsx src/bot/index.ts",
    "start": "tsx src/bot/index.ts",
    "sample": "tsx src/render/sample.ts",
    "assets": "tsx src/render/assets.ts",
    "seedcheck": "tsx src/oracle/seedcheck.ts",
    "webaudit": "tsx src/oracle/web-audit.ts",
    "puzzlefairness": "npm run -s v5bindingcheck && npm run -s v5surfacecheck",
    "voicecheck": "python ../tools/check_voice_register.py",
    "typecheck": "tsc --noEmit --pretty false",
    "audit": "npm run -s v5check && npm run -s v5bindingcheck && npm run -s v5surfacecheck && npm run -s argeventcheck && npm run -s argprojectioncheck && npm run -s nessacorrectioncheck && npm run -s seventhretirementcheck && npm run -s legacyanswershapecheck && npm run -s vnextcampaigncheck && npm run -s identitycheck && npm run -s seedcheck && npm run -s webaudit && npm run -s db:bundlecheck && npm run -s resolvecheck",
    "v5check": "tsx src/v5/canon.selftest.ts",
    "v5bindingcheck": "tsx src/v5/runtime-bindings.selftest.ts",
    "v5surfacecheck": "tsx src/v5/surface.selftest.ts",
    "argeventcheck": "tsx src/v5/arg-events.selftest.ts && tsx src/v5/wren-transmission.selftest.ts && tsx src/v5/settlement-dispatch.selftest.ts",
    "seventhretirementcheck": "tsx src/v5/seventh-retirement.selftest.ts",
    "legacyanswershapecheck": "tsx src/v5/legacy-answer-shape.selftest.ts",
    "argprojectioncheck": "tsx src/v5/arg-projection-worker.selftest.ts",
    "nessacorrectioncheck": "tsx src/v5/nessa-correction.selftest.ts",
    "vnextcampaigncheck": "tsx src/v5/campaign-projection.selftest.ts",
    "m2approvalcheck": "tsx src/v5/approval-gates.selftest.ts",
    "identitycheck": "tsx src/v5/identity-link.selftest.ts",
    "gatecheck": "tsx src/oracle/gate.selftest.ts",
    "resolvecheck": "tsx src/oracle/resolve.selftest.ts",
    "runtimecheck": "npm run -s gatecheck && npm run -s showrunner:test:persistent && npm run -s showrunner:test:all",
    "db:seed": "tsx src/db/build-apply-all.ts",
    "db:apply": "npm run -s db:seed",
    "db:bundlecheck": "tsx src/db/apply-all.selftest.ts",
    "showrunner": "tsx src/showrunner/run.ts",
    "showrunner:dry": "tsx src/showrunner/run.ts --dry-run",
    "showrunner:test": "tsx src/showrunner/decide.selftest.ts",
    "showrunner:test:persistent": "tsx src/showrunner/persistent.selftest.ts",
    "showrunner:test:customs": "tsx src/showrunner/customs.selftest.ts",
    "showrunner:test:herd": "tsx src/showrunner/herd.selftest.ts",
    "showrunner:test:prologue": "tsx src/showrunner/prologue.selftest.ts",
    "showrunner:test:autonomy": "tsx src/showrunner/autonomy.selftest.ts && npm run -s showrunner:test:prologue",
    "showrunner:test:scenario": "tsx src/showrunner/scenario.selftest.ts",
    "showrunner:test:chaos": "tsx src/showrunner/chaos.selftest.ts",
    "showrunner:test:unlit": "tsx src/showrunner/unlit-deep.selftest.ts",
    "showrunner:test:archive": "tsx src/showrunner/archive.selftest.ts",
    "showrunner:test:all": "npm run -s showrunner:test && npm run -s showrunner:test:customs && npm run -s showrunner:test:herd && npm run -s showrunner:test:autonomy && npm run -s showrunner:test:scenario && npm run -s showrunner:test:chaos && npm run -s showrunner:test:unlit && npm run -s showrunner:test:archive",
    "archive:materialize": "tsx src/showrunner/archive.materialize.ts",
    "pack:build": "tsx src/render/build-runepack.ts",
    "pack:proof": "tsx src/render/rune-proof.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.45.4",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "satori": "^0.12.1",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "undici": "^6.27.0"
  }
}
