# The Observance — Discord service environment.
# Copy to .env and fill in. NEVER commit .env (it holds the service-role key).

# --- Discord application ---
# Bot token from the Discord Developer Portal (Bot → Reset Token).
DISCORD_BOT_TOKEN=
# Application (client) ID.
DISCORD_APP_ID=
# Guild (server) ID. Slash commands register per-guild for instant availability.
DISCORD_GUILD_ID=

# --- Channel ID (right-click the channel → Copy Channel ID; Developer Mode on) ---
# #the-record — the Watcher's channel, and the ONLY one the bot posts to
# (reports + clue drops). /whisper is run anywhere; cipher-solving is in #general.
CHANNEL_THE_RECORD=

# --- Supabase (Braden's project; SERVER-SIDE service role) ---
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Service-role key — bypasses RLS. SERVER ONLY. Never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=
