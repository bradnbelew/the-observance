# The Observance V5 Discord service environment.
# Copy to .env and fill in. NEVER commit .env (it holds the service-role key).

# Discord application (Developer Portal).
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=

# Right-click #the-record -> Copy Channel ID (Developer Mode on).
CHANNEL_THE_RECORD=

# Supabase server-side service credentials. Never expose the service-role key to a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Production guard: keep v5. It hard-disables every retired autonomous/ambient producer.
OBSERVANCE_CAMPAIGN_VERSION=v5

# Persistent worker cadence and worker/cron SQL lease.
SHOWRUNNER_TICK_MS=12000
SHOWRUNNER_LEASE_SECONDS=300
