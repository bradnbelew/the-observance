# The Observance — Discord service environment.
# Copy to .env and fill in. NEVER commit .env (it holds the service-role key).

# --- Discord application ---
# Bot token from the Discord Developer Portal (Bot → Reset Token).
DISCORD_BOT_TOKEN=
# Application (client) ID.
DISCORD_APP_ID=
# Guild (server) ID. Slash commands register per-guild for instant availability.
DISCORD_GUILD_ID=

# --- Channel IDs (right-click channel → Copy Channel ID; Developer Mode on) ---
# #the-record — public lore / status posts.
CHANNEL_THE_RECORD=
# #cipherwork — puzzle discussion + clue cards.
CHANNEL_CIPHERWORK=
# #whispers — where the bot delivers tiered whisper hints.
CHANNEL_WHISPERS=
# #the-ways — meta / out-of-character coordination.
CHANNEL_THE_WAYS=

# --- Supabase (Braden's project; SERVER-SIDE service role) ---
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Service-role key — bypasses RLS. SERVER ONLY. Never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=
