# The Observance — Discord service environment.
# Copy to .env and fill in. NEVER commit .env (it holds the service-role key).

# --- Discord application ---
# Bot token from the Discord Developer Portal (Bot → Reset Token).
DISCORD_BOT_TOKEN=
# Application (client) ID.
DISCORD_APP_ID=
# Guild (server) ID. Slash commands register per-guild for instant availability.
DISCORD_GUILD_ID=

# --- Channel ID (right-click the channel → Copy Channel ID; Developer Mode on) ---
# #the-record — the Watcher's channel, and the ONLY one the bot posts to
# (reports + clue drops). /whisper is run anywhere; cipher-solving is in #general.
CHANNEL_THE_RECORD=

# --- Supabase (Braden's project; SERVER-SIDE service role) ---
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Service-role key — bypasses RLS. SERVER ONLY. Never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Observer Tier-2 archivist (OPTIONAL) ---
# Anthropic API key for the LLM archivist that makes the "it heard you" SELECTION smarter (W4.2).
# OPTIONAL by design: if unset, the Observer degrades to the deterministic Tier-1 pick — nothing breaks.
# NOTE: the showrunner runs on the RENDER cron, so this key must live in THIS service's env (not only
# in Vercel/the website). Leave blank until you want the smarter selection live.
ANTHROPIC_API_KEY=

# --- Voice tier "it heard you say it" (OPTIONAL — W5) ---
# All three below (plus the voice_capture setting flipped on in the DB, default off) are required for the
# Watcher to listen in voice. Any absent → the voice tier is a clean no-op. Enable requires a bot restart.
# The voice channel the bot sits in and transcribes (Copy Channel ID on a VOICE channel).
DISCORD_VOICE_CHANNEL_ID=
# Whisper backend — pick ONE. (A) HTTP: an OpenAI/Groq-compatible /audio/transcriptions endpoint:
WHISPER_API_URL=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
WHISPER_LANG=en
# (B) LOCAL: a whisper binary/wrapper that takes a WAV path as its last arg and prints the transcript to
# stdout. Leave the HTTP vars blank if you use this.
WHISPER_BIN=
