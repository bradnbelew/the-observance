    {"surface_id": "SHELTER_JOIN", "cell": [-4,-2,22], "material": "CHISELED_TUFF", "finding_id": "P4.F2", "source_id": "material_join_shelter", "title": "First shelter cut", "body": "Rough tuff courses stop at the original storm shelter width; later ribs are keyed into their faces."},
