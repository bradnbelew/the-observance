    {"surface_id": "DEEP_JOIN", "cell": [-4,-18,52], "material": "CHISELED_DEEPSLATE", "finding_id": "P4.F2", "source_id": "material_join_deep", "title": "Deep works tie-in", "body": "Tile and basalt braces continue below the civic stair, cut around both earlier campaigns rather than beneath one plan."},
    {"surface_id": "POPULATION_BOARD", "cell": [-13,-20,59], "material": "LECTERN", "finding_id": "P4.F3", "source_id": "population_board", "title": "Refuge intake board", "body": "Household marks total 286 residents. Forty-two temporary work berths are recorded separately from sleeping capacity."},
    {"surface_id": "HEAT_WATER_DIAGRAM", "cell": [-13,-20,72], "material": "LECTERN", "finding_id": "P4.F3", "source_id": "heat_water_capacity_diagram", "title": "Heat and water capacity sheet", "body": "Two boilers cover 320 rationed berths. The flume gauge limits intake to 300 until the lower filter bed is commissioned."},
    {"surface_id": "WATER_CHANNEL_GAUGE", "cell": [-8,-18,70], "material": "WAXED_WEATHERED_CUT_COPPER", "finding_id": "P4.F4", "source_id": "recessed_water_channel", "title": "Drainage capacity gauge", "body": "Basin depth, flume width, and sump marks let clerks reject arrivals the drains and filters could not safely serve."},
    {"surface_id": "RATION_LEDGER", "cell": [22,-20,66], "material": "LECTERN", "finding_id": "P4.F3", "source_id": "ration_ledger", "title": "Seven-day ration abstract", "body": "Issued grain and lamp oil support 294 full shares. Work crews draw from the surface store and are not counted as refuge mouths."},
    {"surface_id": "SURVEY_REVISIONS", "cell": [31,-18,65], "material": "CHISELED_BOOKSHELF", "finding_id": "P4.F2", "source_id": "survey_revisions", "title": "Survey revisions A-C", "body": "Revision A ends at the shelter. B adds intake and copy office. C extends the public spine beyond the controlled gate."},
